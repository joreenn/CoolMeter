{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "framework": null,
    "regions": [
        "sin1"
    ],
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.9.0"
        },
        {
            "src": "public/*.css",
            "use": "@vercel/static"
        },
        {
            "src": "public/*.js",
            "use": "@vercel/static"
        },
        {
            "src": "public/*.svg",
            "use": "@vercel/static"
        },
        {
            "src": "public/*.png",
            "use": "@vercel/static"
        },
        {
            "src": "public/*.webmanifest",
            "use": "@vercel/static"
        },
        {
            "src": "public/offline.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(app\\.css|app\\.js|theme\\.js|icon\\.svg|icon-192\\.png|icon-512\\.png|manifest\\.webmanifest|sw\\.js|offline\\.html)",
            "dest": "/public/$1",
            "headers": {
                "X-Content-Type-Options": "nosniff"
            }
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php",
            "headers": {
                "Cache-Control": "private, no-store",
                "X-Content-Type-Options": "nosniff",
                "X-Frame-Options": "DENY",
                "Referrer-Policy": "same-origin"
            }
        }
    ],
    "env": {
        "APP_NAME": "CoolMeter",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "COOLMETER_REQUIRE_LOGIN": "true",
        "COOLMETER_SERVERLESS": "true",
        "DB_CONNECTION": "pgsql",
        "DB_SSLMODE": "require",
        "SESSION_DRIVER": "database",
        "SESSION_SECURE_COOKIE": "true",
        "SESSION_SAME_SITE": "lax",
        "CACHE_STORE": "database",
        "LOG_CHANNEL": "stderr",
        "QUEUE_CONNECTION": "sync"
    }
}
